{
  "name": "ucareer",
  "version": "1.8.1",
  "description": "Local AI career workspace for Ucareer",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "doctor": "node scripts/cli/doctor.mjs",
    "verify": "node scripts/cli/verify-pipeline.mjs",
    "normalize": "node scripts/cli/normalize-statuses.mjs",
    "dedup": "node scripts/cli/dedup-tracker.mjs",
    "merge": "node scripts/cli/merge-tracker.mjs",
    "tracker": "node scripts/cli/tracker-workflow.mjs",
    "pdf": "node scripts/cli/generate-pdf.mjs",
    "latex": "node scripts/cli/generate-latex.mjs",
    "daemon": "npm run daemon:python",
    "daemon:api": "npm run daemon:python",
    "daemon:python": "PYTHONPATH=apps/py-daemon/src python3 -m ucareer_py_daemon",
    "daemon:node": "npm --workspace @ucareer/daemon run dev",
    "daemon:python:test": "PYTHONPATH=apps/py-daemon/src python3 -m unittest discover apps/py-daemon/tests",
    "dev:ucareer": "node scripts/dev/dev-ucareer.mjs",
    "api": "npm --workspace @ucareer/api run dev",
    "web": "npm --workspace @ucareer/web run dev",
    "web:build": "npm --workspace @ucareer/web run build",
    "web:responsive": "node scripts/dev/responsive-audit.mjs",
    "workspace:audit": "node scripts/cli/audit-workspace-boundary.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync-check": "node scripts/cli/cv-sync-check.mjs",
    "liveness": "node scripts/cli/check-liveness.mjs",
    "scan": "node scripts/cli/scan.mjs",
    "followup": "node scripts/cli/followup-cadence.mjs",
    "crawl:china": "node scripts/research/china-job-crawler.mjs",
    "radar:boss": "node scripts/research/boss-agent-radar.mjs",
    "analyze:china-market": "node scripts/research/analyze-market-clusters.mjs",
    "patterns": "node scripts/cli/analyze-patterns.mjs",
    "gemini:eval": "node scripts/cli/gemini-eval.mjs",
    "test:unit": "node --import tsx --test apps/**/*.test.ts packages/**/*.test.ts",
    "test:all": "node scripts/cli/test-all.mjs"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "career",
    "ucareer",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.0.0",
    "js-yaml": "^4.1.1",
    "playwright": "^1.58.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
