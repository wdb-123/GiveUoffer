{
  "manifest_version": 3,
  "name": "Career-Ops JD Parser",
  "version": "0.1.0",
  "description": "Read logged-in job detail pages and write structured JD data back to local Career-Ops.",
  "permissions": ["tabs", "scripting", "alarms"],
  "host_permissions": [
    "http://localhost:4173/*",
    "http://127.0.0.1:4173/*",
    "https://www.zhipin.com/*",
    "https://*.zhipin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:4173/*", "http://127.0.0.1:4173/*"],
      "js": ["localhost-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.zhipin.com/*", "https://*.zhipin.com/*"],
      "js": ["job-page-scraper.js"],
      "run_at": "document_idle"
    }
  ]
}
